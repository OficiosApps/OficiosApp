# Configurar en Railway > Variables. Nunca pegar secretos en el código ni en VITE_*.
# URL HTTPS pública sin ruta ni barra final. RAILWAY_PUBLIC_DOMAIN sirve de alternativa.
APP_URL=https://TU-DOMINIO.up.railway.app
# Crear un volumen Railway montado en /data. Base de datos y fotos quedan en ese volumen.
DATA_DIR=/data
# Cliente OAuth de tipo Aplicación web creado en Google Cloud.
# Callback autorizado: https://TU-DOMINIO.up.railway.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail autorizado como CEO; el servidor exige ingreso verificado por Google.
OFICIOS_CEO_EMAIL=tadeoacua22@gmail.com
# Opcional para activar Ayuda IA; sólo en variables privadas del servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Railway proporciona PORT automáticamente; el dominio debe apuntar a ese puerto (8080 por defecto).

# Correo transaccional de invitaciones: crear API key en Brevo y verificar este remitente.
BREVO_API_KEY=
MAIL_FROM=pqroficiosapp@gmail.com
